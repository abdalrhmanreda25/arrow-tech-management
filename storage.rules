rules_version = '2';

// Membership is read from Firestore, so Storage enforces the same org
// isolation and roles as firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function memberPath(orgId) {
      return /databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function rankOf(role) {
      return {'viewer': 1, 'member': 2, 'manager': 3, 'admin': 4, 'owner': 5}[role];
    }

    function isMember(orgId) {
      return request.auth != null
        && firestore.exists(memberPath(orgId))
        && firestore.get(memberPath(orgId)).data.status == 'active';
    }

    function hasRole(orgId, minRole) {
      return isMember(orgId) && rankOf(firestore.get(memberPath(orgId)).data.role) >= rankOf(minRole);
    }

    function allowedType() {
      return request.resource.contentType.matches('image/(png|jpeg|gif|webp)')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('text/(plain|csv|markdown)')
        || request.resource.contentType.matches('application/(zip|json)')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*');
    }

    // Item attachments: orgs/{orgId}/items/{itemId}/{attachmentId}
    match /orgs/{orgId}/items/{itemId}/{attachmentId} {
      allow read: if isMember(orgId);
      allow create: if hasRole(orgId, 'member')
        && request.resource.size <= 10 * 1024 * 1024
        && allowedType()
        && request.resource.metadata.uploadedBy == request.auth.uid;
      allow update: if false;
      // The item's creator may clear attachments when deleting the item.
      allow delete: if hasRole(orgId, 'manager')
        || (hasRole(orgId, 'member') && (resource.metadata.uploadedBy == request.auth.uid
          || firestore.get(/databases/(default)/documents/orgs/$(orgId)/items/$(itemId)).data.createdBy == request.auth.uid));
    }

    // Organization logo.
    match /orgs/{orgId}/branding/{fileName} {
      allow read: if isMember(orgId);
      allow write: if hasRole(orgId, 'admin')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Profile photos.
    match /users/{uid}/avatar/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
