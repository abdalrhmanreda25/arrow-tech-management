{
  "name": "arrow-tech-management",
  "version": "1.0.0",
  "description": "Arrow Tech team management dashboard: organizations, projects, Scrum sprints and reports on Firebase.",
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "NEXT_PUBLIC_USE_EMULATORS=true next dev",
    "build": "next build",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-arrow-tech \"vitest run --project emulator\"",
    "test": "pnpm test:unit && pnpm test:emulator && pnpm test:integration",
    "emulators": "firebase emulators:start --project demo-arrow-tech",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "pnpm build && firebase deploy --only hosting",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-arrow-tech \"vitest run --project integration\""
  },
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "firebase": "^13.0.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true
}
